# GROUP_MODEL=claude-opus-5-5
# IDEAS_MODEL=claude-opus-5-5
# CHECK_MODEL=claude-haiku-5-5

# Optional demo limits, per visitor per hour
# RUNS_PER_HOUR=6
# CHECKS_PER_HOUR=20
